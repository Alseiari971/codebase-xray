{
  "name": "codebase-xray",
  "version": "0.1.0",
  "description": "AI can build your software. Now understand what it built. An evidence-grounded, interactive map of your codebase.",
  "type": "module",
  "bin": {
    "xray": "bin/xray.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "xray": "node bin/xray.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/schema.test.ts test/cluster.test.ts test/typescript-adapter.test.ts test/indexer.test.ts test/diff.test.ts test/traverse.test.ts test/web-model.test.ts test/server.test.ts test/mcp.test.ts test/cli.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alseiari971/codebase-xray.git"
  },
  "keywords": [
    "architecture",
    "codebase",
    "code-map",
    "dependency-graph",
    "mcp",
    "static-analysis"
  ],
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "12.9.0",
    "esbuild": "^0.28.2",
    "ignore": "^7.0.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
